{
    "schema": {
      "type": "object",
      "required": ["kind", "metadata", "spec"],
      "properties": {
        "kind": {
          "type": "string",
          "const": "Dashboard"
        },
        "metadata": {
          "type": "object",
          "required": ["name"],
          "properties": {
            "name": {
              "type": "string",
              "description": "Dashboard name"
            },
            "project": {
              "type": "string",
              "description": "Project the dashboard belongs to"
            },
            "createdAt": {
              "type": "string",
              "format": "date-time"
            },
            "updatedAt": {
              "type": "string",
              "format": "date-time"
            },
            "version": {
              "type": "integer"
            }
          }
        },
        "spec": {
          "type": "object",
          "required": ["panels", "layouts"],
          "properties": {
            "display": {
              "type": "object",
              "properties": {
                "name": {"type": "string"},
                "description": {"type": "string"}
              }
            },
            "datasources": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "kind": {"type": "string"},
                  "spec": {"type": "object"}
                }
              }
            },
            "variables": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["kind", "spec"],
                "properties": {
                  "kind": {
                    "type": "string",
                    "enum": ["TextVariable", "ListVariable"]
                  },
                  "spec": {
                    "type": "object",
                    "required": ["name"],
                    "properties": {
                      "name": {"type": "string"},
                      "display": {
                        "type": "object",
                        "properties": {
                          "name": {"type": "string"},
                          "description": {"type": "string"},
                          "hidden": {"type": "boolean"}
                        }
                      }
                    }
                  }
                }
              }
            },
            "panels": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "required": ["kind", "spec"],
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "Panel"
                  },
                  "spec": {
                    "type": "object",
                    "required": ["display", "plugin"],
                    "properties": {
                      "display": {
                        "type": "object",
                        "required": ["name"],
                        "properties": {
                          "name": {"type": "string"},
                          "description": {"type": "string"}
                        }
                      },
                      "plugin": {
                        "type": "object",
                        "required": ["kind", "spec"],
                        "properties": {
                          "kind": {"type": "string"},
                          "spec": {"type": "object"}
                        }
                      },
                      "queries": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "required": ["kind", "spec"],
                          "properties": {
                            "kind": {"type": "string"},
                            "spec": {
                              "type": "object",
                              "required": ["plugin"],
                              "properties": {
                                "plugin": {
                                  "type": "object",
                                  "required": ["kind", "spec"],
                                  "properties": {
                                    "kind": {"type": "string"},
                                    "spec": {"type": "object"}
                                  }
                                }
                              }
                            }
                          }
                        }
                      },
                      "links": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "required": ["url"],
                          "properties": {
                            "name": {"type": "string"},
                            "url": {"type": "string"},
                            "tooltip": {"type": "string"},
                            "renderVariables": {"type": "boolean"},
                            "targetBlank": {"type": "boolean"}
                          }
                        }
                      }
                    }
                  }
                }
              }
            },
            "layouts": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["kind", "spec"],
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "Grid"
                  },
                  "spec": {
                    "type": "object",
                    "required": ["display"],
                    "properties": {
                      "display": {
                        "type": "object",
                        "required": ["title"],
                        "properties": {
                          "title": {"type": "string"},
                          "collapse": {
                            "type": "object",
                            "properties": {
                              "open": {"type": "boolean"}
                            }
                          }
                        }
                      },
                      "items": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "required": ["x", "y", "width", "height", "content"],
                          "properties": {
                            "x": {"type": "integer"},
                            "y": {"type": "integer"},
                            "width": {"type": "integer"},
                            "height": {"type": "integer"},
                            "content": {
                              "type": "object",
                              "properties": {
                                "$ref": {"type": "string"}
                              }
                            }
                          }
                        }
                      },
                      "repeatVariable": {"type": "string"}
                    }
                  }
                }
              }
            },
            "duration": {
              "type": "string",
              "default": "1h",
              "pattern": "^[0-9]+(ns|us|µs|ms|s|m|h)$"
            },
            "refreshInterval": {
              "type": "string",
              "pattern": "^[0-9]+(ns|us|µs|ms|s|m|h)$"
            }
          }
        }
      }
    },
    "examples": [
      {
        "kind": "Dashboard",
        "metadata": {
          "name": "sample-dashboard",
          "project": "default"
        },
        "spec": {
          "display": {
            "name": "Sample Dashboard",
            "description": "A sample monitoring dashboard"
          },
          "panels": {
            "panel-1": {
              "kind": "Panel",
              "spec": {
                "display": {
                  "name": "CPU Usage"
                },
                "plugin": {
                  "kind": "TimeSeriesChart",
                  "spec": {}
                }
              }
            }
          },
          "layouts": [
            {
              "kind": "Grid",
              "spec": {
                "display": {
                  "title": "Main"
                },
                "items": [
                  {
                    "x": 0,
                    "y": 0,
                    "width": 12,
                    "height": 8,
                    "content": {
                      "$ref": "#/spec/panels/panel-1"
                    }
                  }
                ]
              }
            }
          ],
          "duration": "1h"
        }
      }
    ]
  }
